KARTIFY_ENV=development
KARTIFY_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
KARTIFY_ADMIN_EMAIL=you@example.com
KARTIFY_ADMIN_SETUP_TOKEN=replace-with-a-private-random-admin-setup-token
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-your-private-facebook-app-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local default is SQLite. Use a PostgreSQL URL for hosted environments.
# DATABASE_URL=postgresql://user:password@host:5432/kartify?sslmode=require
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-private-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-private-webhook-secret
